## 5. kNN-регрессия времени расследования

```python
reg_pipe = Pipeline([
    ("scaler", StandardScaler()),
    ("knn", KNeighborsRegressor()),
])

cv_reg = KFold(
    n_splits=5,
    shuffle=True,
    random_state=RANDOM_STATE,
)

param_grid_reg = {
    "knn__n_neighbors": k_values,
    "knn__weights": ["uniform", "distance"],
    "knn__p": [1, 2],
}

reg_search = GridSearchCV(
    estimator=reg_pipe,
    param_grid=param_grid_reg,
    scoring="neg_mean_absolute_error",
    cv=cv_reg,
    return_train_score=True,
)

reg_search.fit(X_tr, y_time_tr)

mae_cv = -reg_search.best_score_
print("Лучшие параметры:")
print(reg_search.best_params_)
print(f"\nСредняя MAE на CV: {mae_cv:.2f} мин")

cv_res_reg = pd.DataFrame(reg_search.cv_results_)
show_cols_reg = [
    "param_knn__n_neighbors",
    "param_knn__weights",
    "param_knn__p",
    "mean_train_score",
    "mean_test_score",
    "std_test_score",
]
top8_reg = (
    cv_res_reg
    .sort_values("rank_test_score")
    .loc[:, show_cols_reg]
    .head(8)
    .copy()
)
top8_reg["mean_train_score"] *= -1
top8_reg["mean_test_score"] *= -1
top8_reg.round(3)

best_reg = reg_search.best_estimator_

y_time_pred = best_reg.predict(X_te)

print("Первые пять прогнозов:")
print(y_time_pred[:5])

mae = mean_absolute_error(y_time_te, y_time_pred)
rmse = np.sqrt(mean_squared_error(y_time_te, y_time_pred))
r2 = r2_score(y_time_te, y_time_pred)

print(f"MAE: {mae:.2f} min")
print(f"RMSE: {rmse:.2f} min")
print(f"R^2: {r2:.3f}")
```

