def assign_to_nearest_cluster(X, cluster_ids, centroids):
    distance_matrix = np.linalg.norm(X[:, np.newaxis, :] - centroids[np.newaxis, :, :], axis=2)
    nearest_positions = np.argmin(distance_matrix, axis=1)
    assigned_clusters = cluster_ids[nearest_positions]
    anomaly_scores = distance_matrix[np.arange(len(X)), nearest_positions]
    return assigned_clusters, anomaly_scores

