fitted_scaler = best_classification_model.named_steps["scaler"]
# "Достаём" обученный классификатор kNN из пайпайна.
fitted_knn = best_classification_model.named_steps["knn"]
# Применяем масштабирование к новому объекту
uncertain_scaled = fitted_scaler.transform(uncertain_object)
# Вычисляем расстояния до ближайших соседей и находим их индексы
