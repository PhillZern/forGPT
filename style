import time
# Масштабируем данные один раз, поскольку здесь сравнивается только способ поиска.
timing_scaler = StandardScaler()
X_train_scaled = timing_scaler.fit_transform(X_train)
X_test_scaled = timing_scaler.transform(X_test)
# Используем лучшие найденные значения k, weights и p для всех вариантов поиска.
best_knn_params = classification_search.best_params_
search_algorithms = ["brute", "kd_tree", "ball_tree"]
timing_rows = []
predictions_by_algorithm = {}
for algorithm in search_algorithms:
    search_model = KNeighborsClassifier(n_neighbors = best_knn_params["knn__n_neighbors"],
                                        weights = best_knn_params["knn__weights"],
                                        p = best_knn_params["knn__p"],
                                        algorithm = algorithm)
    # Измеряем построение внутренней структуры поиска.
    fit_start = time.perf_counter()
    search_model.fit(X_train_scaled, y_class_train)
    fit_ms = (time.perf_counter() - fit_start) * 1000
    # Повторяем прогноз, чтобы уменьшить влияние погрешности таймера.
    repetitions = 30
    predict_start = time.perf_counter()
    for _ in range(repetitions):
        current_prediction = search_model.predict(X_test_scaled)
    predict_ms = (time.perf_counter() - predict_start) * 1000 / repetitions
    predictions_by_algorithm[algorithm] = current_prediction
    timing_rows.append({"Алгоритм": algorithm,
                        "Время обучения, мс": fit_ms,
                        "Время формирования прогноза, мс": predict_ms})
# Проверяем соблюдение прогнозов с полным перебором.
brute_prediction = predictions_by_algorithm["brute"]
for algorithm in ["kd_tree", "ball_tree"]:
    matches = np.array_equal(brute_prediction, predictions_by_algorithm[algorithm])
    print(f"Прогноз {algorithm} совпадает с brute: {matches}")
pd.DataFrame(timing_rows).round(3)

